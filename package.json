{
  "name": "dlatot-magen-configurator",
  "private": true,
  "version": "0.1.0",
  "description": "Door configurator for Dlatot Magen",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "test": "node test/units.mjs",
    "shot": "node tools/screenshot.mjs",
    "compare": "node tools/compare.mjs",
    "hardware": "node tools/hardware.mjs",
    "measure": "node tools/measure.mjs",
    "ask": "node tools/ask.mjs",
    "frame": "node tools/frame.mjs",
    "recreate": "node tools/recreate.mjs",
    "audit": "node tools/audit.mjs",
    "glass": "node tools/glass.mjs",
    "mottle": "node tools/mottle.mjs",
    "leaf": "node tools/leaf.mjs",
    "triage": "node tools/triage.mjs",
    "collide": "node tools/collide.mjs",
    "profile": "node tools/profile.mjs",
    "against": "node tools/against.mjs",
    "fuzz": "node tools/fuzz.mjs",
    "corpus": "node tools/corpus.mjs",
    "sheets": "npm run shot && npm run recreate && npm run corpus && npm run against"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
