@charset "utf-8";

:root { --ivory: #F4F1EA; --paper: #FBFAF6; --ink: #0E0E0F; --ink-soft: #17171A; --gold: #C9A24A; --grey: #8A857B; --hair: rgba(14,14,15,.14); --hair-light: rgba(244,241,234,.18); --serif: 'Rubik', system-ui, sans-serif; --sans: 'Rubik', system-ui, sans-serif; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; text-size-adjust: 100%; }

body { font-family: var(--sans); background: var(--ivory); color: var(--ink); font-weight: 300; line-height: 1.7; font-size: 17px; overflow-x: hidden; }

img { max-width: 100%; display: block; }

a { color: inherit; text-decoration: none; }

.wrap { max-width: 1200px; margin-inline: auto; padding-inline: 32px; }

.label { font-family: var(--sans); font-weight: 400; font-size: 11px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold); }

html[lang="he"] .label { letter-spacing: 0.18em; }

.label.muted { color: var(--grey); }

h1, h2, h3 { font-family: var(--serif); font-weight: 700; line-height: 1.1; letter-spacing: -0.01em; }

h1 em, h2 em, h3 em { font-style: normal; color: var(--gold); font-weight: 700; }

.only-he { display: none; }

html[lang="he"] .only-he { display: inline; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; font-family: var(--sans); font-weight: 400; font-size: 12.5px; letter-spacing: 0.16em; text-transform: uppercase; padding: 14px 26px; border: 1px solid transparent; cursor: pointer; transition: 0.3s; white-space: nowrap; min-height: 48px; }

html[lang="he"] .btn { letter-spacing: 0.06em; font-weight: 500; }

.btn svg { width: 16px; height: 16px; flex-shrink: 0; }

.btn-dark { background: var(--ink); color: var(--ivory); }

.btn-dark:hover { background: var(--gold); color: var(--ink); }

.btn-ghost { background: transparent; color: var(--ink); border-color: var(--ink); }

.btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

.btn-gold { background: var(--gold); color: var(--ink); }

.btn-gold:hover { background: var(--ink); color: var(--ivory); }

.btn-outline-light { background: transparent; color: var(--ivory); border-color: rgba(244, 241, 234, 0.4); }

.btn-outline-light:hover { border-color: var(--gold); color: var(--gold); }

header { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 100; background: rgba(244, 241, 234, 0.86); backdrop-filter: blur(14px); border-bottom: 1px solid var(--hair); transition: background 0.4s; }

.nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 78px; }

.brand { display: flex; align-items: center; gap: 13px; min-width: 0px; }

.brand img { height: 42px; width: 42px; object-fit: cover; border: 1px solid var(--hair); }

.brand .bt { display: flex; flex-direction: column; line-height: 1; }

.brand .bt strong { font-family: var(--serif); font-weight: 600; font-size: 21px; letter-spacing: 0.02em; }

.brand .bt span { font-size: 9.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--grey); margin-top: 4px; white-space: nowrap; }

html[lang="he"] .brand .bt span { letter-spacing: 0.12em; }

.nav-links { display: flex; align-items: center; gap: 26px; }

.nav-links a { font-size: 12.5px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 400; color: var(--ink); position: relative; padding: 4px 0px; transition: color 0.3s; white-space: nowrap; }

html[lang="he"] .nav-links a { letter-spacing: 0.05em; font-size: 14px; }

html:not([lang="he"]) .nav-links { gap: 18px; }

html:not([lang="he"]) .nav-links a { letter-spacing: 0.07em; font-size: 12px; }

.desktop-call { white-space: nowrap; }

.nav-links a::after { content: ""; position: absolute; inset-inline-start: 0px; bottom: 0px; height: 1px; width: 0px; background: var(--gold); transition: width 0.35s; }

.nav-links a:hover, .nav-links a.active { color: var(--gold); }

.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }

.nav-cta { display: flex; align-items: center; gap: 12px; }

.lang { display: inline-flex; align-items: center; border: 1px solid var(--hair); overflow: hidden; }

.lang button { font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.1em; font-weight: 500; padding: 8px 11px; background: transparent; border: 0px; cursor: pointer; color: var(--grey); min-height: 38px; transition: 0.25s; text-transform: uppercase; }

.lang button + button { border-inline-start: 1px solid var(--hair); }

.lang button:hover { color: var(--ink); }

.lang button.on { background: var(--ink); color: var(--ivory); }

.hamburger { display: none; width: 46px; height: 46px; border: 1px solid var(--hair); background: transparent; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }

.hamburger span { display: block; width: 20px; height: 1.4px; background: var(--ink); transition: 0.3s; }

.hamburger.open span:nth-child(1) { transform: translateY(6.4px) rotate(45deg); }

.hamburger.open span:nth-child(2) { opacity: 0; }

.hamburger.open span:nth-child(3) { transform: translateY(-6.4px) rotate(-45deg); }

.mobile-menu { position: fixed; inset: 0px; z-index: 99; background: var(--ink); color: var(--ivory); transform: translateY(-100%); transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1); display: flex; flex-direction: column; justify-content: center; gap: 0px; padding: 96px 32px 40px; visibility: hidden; overflow-y: auto; }

.mobile-menu.open { transform: translateY(0px); visibility: visible; }

.mobile-menu a.m-link { display: block; font-family: var(--serif); font-size: 30px; font-weight: 700; padding: 13px 0px; color: var(--ivory); border-bottom: 1px solid var(--hair-light); transition: color 0.3s, padding-inline-start 0.3s; }

.mobile-menu a.m-link:hover, .mobile-menu a.m-link:active { color: var(--gold); padding-inline-start: 10px; }

.mobile-menu .m-lang { display: flex; justify-content: center; margin-top: 28px; }

.mobile-menu .lang { border-color: var(--hair-light); }

.mobile-menu .lang button { color: rgba(244, 241, 234, 0.72); border-color: var(--hair-light); padding: 11px 20px; font-size: 13px; }

.mobile-menu .lang button + button { border-color: var(--hair-light); }

.mobile-menu .lang button.on { background: var(--gold); color: var(--ink); }

.mobile-menu .m-cta { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }

.mobile-menu .m-cta .btn { width: 100%; }

.hero { background: var(--ink); color: var(--ivory); padding-top: 78px; position: relative; overflow: hidden; }

.hero .wrap { padding-inline: 0px; }

.hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; min-height: calc(-78px + 100vh); align-items: center; }

.hero-copy { padding-block: 80px; padding-inline: 32px 64px; }

.hero-copy .label { margin-bottom: 28px; display: inline-block; }

.hero h1 { font-size: clamp(46px, 6.2vw, 92px); font-weight: 500; margin-bottom: 28px; color: var(--ivory); }

.hero-price { font-family: var(--serif); font-weight: 700; font-size: clamp(42px, 5.4vw, 64px); color: var(--gold); line-height: 1; margin-bottom: 24px; }

.hero-price small { display: block; font-family: var(--sans); font-weight: 400; font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(244, 241, 234, 0.6); margin-bottom: 10px; }

html[lang="he"] .hero-price small { letter-spacing: 0.08em; }

.hero-includes { max-width: 520px; margin-bottom: 36px; }

.hero-includes-label { display: block; font-size: 12.5px; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }

html[lang="he"] .hero-includes-label { letter-spacing: 0.06em; }

.hero-includes-text { font-size: 17px; font-weight: 300; color: rgba(244, 241, 234, 0.85); line-height: 1.85; }

.hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }

.btn-stack { flex-direction: column; gap: 5px; padding: 17px 30px; min-height: 70px; }

.btn-stack .btn-sub { font-size: 10.5px; font-weight: 400; letter-spacing: 0.03em; text-transform: none; opacity: 0.72; }

.hero-figure { position: relative; height: 100%; min-height: 520px; display: flex; align-items: stretch; }

.hero-figure::before { content: ""; position: absolute; inset: 0px; z-index: 2; pointer-events: none; background: linear-gradient(90deg,var(--ink) 0%,rgba(14,14,15,0) 30%); }

html[dir="rtl"] .hero-figure::before { background: linear-gradient(270deg,var(--ink) 0%,rgba(14,14,15,0) 30%); }

.hero-figure img { width: 100%; height: 100%; object-fit: cover; object-position: center 34%; filter: saturate(0.98) contrast(1.02); }

.hero-meta { position: absolute; bottom: 26px; inset-inline-end: 26px; z-index: 3; text-align: end; background: rgba(14, 14, 15, 0.62); backdrop-filter: blur(6px); border-inline-end: 2px solid var(--gold); padding: 12px 16px; }

.hero-meta .n { font-family: var(--serif); font-weight: 700; font-size: 26px; color: var(--ivory); line-height: 1; }

.hero-meta .t { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(244, 241, 234, 0.72); margin-top: 6px; }

.strip { background: var(--ink); border-top: 1px solid var(--hair-light); overflow: hidden; white-space: nowrap; padding: 18px 0px; }

.strip-track { display: inline-flex; animation: 46s linear 0s infinite normal none running scroll; }

html[dir="rtl"] .strip-track { animation-direction: reverse; }

.strip-track span { font-family: var(--serif); font-weight: 500; font-size: 18px; color: rgba(244, 241, 234, 0.5); padding: 0px 30px; letter-spacing: 0.02em; }

.strip-track span::after { content: "Â·"; color: var(--gold); margin-inline-start: 30px; font-style: normal; }

@keyframes scroll { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

section { padding: 118px 0px; }

.sec-head { max-width: 720px; margin-bottom: 64px; }

.sec-head .label { display: inline-block; margin-bottom: 20px; }

.sec-head h2 { font-size: clamp(34px, 4.4vw, 58px); font-weight: 500; }

.sec-head p { margin-top: 22px; color: var(--grey); font-size: 17px; max-width: 600px; }

.center { text-align: center; margin-inline: auto; }

.offers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }

.offer { background: var(--paper); border: 1px solid var(--hair); display: flex; flex-direction: column; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s; }

.offer:hover { transform: translateY(-4px); box-shadow: rgba(14, 14, 15, 0.5) 0px 24px 50px -30px; }

.offer .tile { aspect-ratio: 1 / 1; background: rgb(255, 255, 255); overflow: hidden; position: relative; border-bottom: 1px solid var(--hair); display: flex; align-items: center; justify-content: center; }

.offer .tile img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1); }

.offer:hover .tile img { transform: scale(1.04); }

.offer .tile.icon { background: var(--ink); }

.offer .tile.icon svg { width: 56px; height: 56px; stroke: var(--gold); fill: none; stroke-width: 1.1; padding: 0px; }

.offer .tile.photo { background: var(--ink); }

.offer .tile.photo img { width: 100%; height: 100%; object-fit: cover; padding: 0px; }

